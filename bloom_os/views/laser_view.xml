<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bloom_laser_tree" model="ir.ui.view">
        <field name="name">bloom.laser.tree</field>
        <field name="model">bloom.laser</field>
        <field name="arch" type="xml">
            <tree>
                <field name="patient_id"/>
                <field name="session_date"/>
                <field name="area"/>
                <field name="machine"/>
            </tree>
        </field>
    </record>

    <record id="view_bloom_laser_form" model="ir.ui.view">
        <field name="name">bloom.laser.form</field>
        <field name="model">bloom.laser</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="patient_id"/>
                        <field name="session_date"/>
                        <field name="area"/>
                        <field name="machine"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bloom_laser_search" model="ir.ui.view">
        <field name="name">bloom.laser.search</field>
        <field name="model">bloom.laser</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="area"/>
                <field name="machine"/>
                <group expand="0" string="Group By">
                    <filter string="Patient" name="group_patient" context="{'group_by': 'patient_id'}"/>
                    <filter string="Area" name="group_area" context="{'group_by': 'area'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bloom_laser" model="ir.actions.act_window">
        <field name="name">Laser Sessions</field>
        <field name="res_model">bloom.laser</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_bloom_laser_search"/>
    </record>

    <menuitem id="menu_bloom_laser" name="Laser" parent="menu_bloom_root" action="action_bloom_laser" sequence="30"/>
</odoo>
