<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bloom_appointment_tree" model="ir.ui.view">
        <field name="name">bloom.appointment.tree</field>
        <field name="model">bloom.appointment</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'confirmed'" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'">
                <field name="patient_id"/>
                <field name="staff_id"/>
                <field name="date"/>
                <field name="service_type"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_bloom_appointment_form" model="ir.ui.view">
        <field name="name">bloom.appointment.form</field>
        <field name="model">bloom.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" states="draft"/>
                    <button name="action_done" type="object" string="Mark Done" states="confirmed"/>
                    <button name="action_cancel" type="object" string="Cancel" states="draft,confirmed"/>
                    <button name="action_draft" type="object" string="Reset to Draft" states="done,cancelled"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="staff_id"/>
                            <field name="service_type"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bloom_appointment_search" model="ir.ui.view">
        <field name="name">bloom.appointment.search</field>
        <field name="model">bloom.appointment</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="staff_id"/>
                <field name="service_type"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Patient" name="group_patient" context="{'group_by': 'patient_id'}"/>
                    <filter string="Staff" name="group_staff" context="{'group_by': 'staff_id'}"/>
                    <filter string="Service" name="group_service" context="{'group_by': 'service_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bloom_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">bloom.appointment</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_bloom_appointment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create and manage patient appointments</p>
        </field>
    </record>

    <menuitem id="menu_bloom_appointment" name="Appointments" parent="menu_bloom_root" action="action_bloom_appointment" sequence="20"/>
</odoo>
