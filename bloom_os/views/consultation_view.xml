<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bloom_consultation_tree" model="ir.ui.view">
        <field name="name">bloom.consultation.tree</field>
        <field name="model">bloom.consultation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="patient_id"/>
                <field name="date"/>
                <field name="consent_given"/>
            </tree>
        </field>
    </record>

    <record id="view_bloom_consultation_form" model="ir.ui.view">
        <field name="name">bloom.consultation.form</field>
        <field name="model">bloom.consultation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="patient_id"/>
                        <field name="date"/>
                        <field name="body_area"/>
                        <field name="derma_plan"/>
                        <field name="consent_given"/>
                        <field name="consent_signature" widget="signature"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bloom_consultation_search" model="ir.ui.view">
        <field name="name">bloom.consultation.search</field>
        <field name="model">bloom.consultation</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <group expand="0" string="Group By">
                    <filter string="Patient" name="group_patient" context="{'group_by': 'patient_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bloom_consultation" model="ir.actions.act_window">
        <field name="name">Consultations</field>
        <field name="res_model">bloom.consultation</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_bloom_consultation_search"/>
    </record>

    <menuitem id="menu_bloom_consultation" name="Consultations" parent="menu_bloom_root" action="action_bloom_consultation" sequence="25"/>
</odoo>
