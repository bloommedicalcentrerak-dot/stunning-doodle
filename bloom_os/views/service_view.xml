<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bloom_service_tree" model="ir.ui.view">
        <field name="name">bloom.service.tree</field>
        <field name="model">bloom.service</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="service_type"/>
                <field name="price"/>
                <field name="duration"/>
                <field name="room_id"/>
            </tree>
        </field>
    </record>

    <record id="view_bloom_service_form" model="ir.ui.view">
        <field name="name">bloom.service.form</field>
        <field name="model">bloom.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="service_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="duration"/>
                            <field name="room_id"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bloom_service_search" model="ir.ui.view">
        <field name="name">bloom.service.search</field>
        <field name="model">bloom.service</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="service_type"/>
                <group expand="0" string="Group By">
                    <filter string="Service Type" name="group_type" context="{'group_by': 'service_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bloom_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">bloom.service</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_bloom_service_search"/>
    </record>

    <menuitem id="menu_bloom_service" name="Services" parent="menu_bloom_config" action="action_bloom_service" sequence="30"/>
</odoo>
