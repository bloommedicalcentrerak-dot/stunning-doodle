<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bloom_team_tree" model="ir.ui.view">
        <field name="name">bloom.team.tree</field>
        <field name="model">bloom.team</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="role"/>
                <field name="phone"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_bloom_team_form" model="ir.ui.view">
        <field name="name">bloom.team.form</field>
        <field name="model">bloom.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="role"/>
                        <field name="phone"/>
                        <field name="active"/>
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="Devices">
                            <field name="device_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="serial_number"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bloom_team" model="ir.actions.act_window">
        <field name="name">Team</field>
        <field name="res_model">bloom.team</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_bloom_team" name="Team" parent="menu_bloom_root" action="action_bloom_team" sequence="50"/>
</odoo>
