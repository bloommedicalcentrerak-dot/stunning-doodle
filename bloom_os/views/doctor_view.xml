<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bloom_doctor_tree" model="ir.ui.view">
        <field name="name">bloom.doctor.tree</field>
        <field name="model">bloom.doctor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="role"/>
                <field name="specialty"/>
                <field name="room_id"/>
                <field name="phone"/>
            </tree>
        </field>
    </record>

    <record id="view_bloom_doctor_form" model="ir.ui.view">
        <field name="name">bloom.doctor.form</field>
        <field name="model">bloom.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="role"/>
                            <field name="specialty"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="room_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bloom_doctor_search" model="ir.ui.view">
        <field name="name">bloom.doctor.search</field>
        <field name="model">bloom.doctor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="specialty"/>
                <field name="room_id"/>
                <filter string="Doctors" name="doctors" domain="[('role', '=', 'doctor')]"/>
                <group expand="0" string="Group By">
                    <filter string="Role" name="group_role" context="{'group_by': 'role'}"/>
                    <filter string="Room" name="group_room" context="{'group_by': 'room_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bloom_doctor" model="ir.actions.act_window">
        <field name="name">Doctors &amp; Staff</field>
        <field name="res_model">bloom.doctor</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_bloom_doctor_search"/>
    </record>

    <menuitem id="menu_bloom_doctor" name="Doctors &amp; Staff" parent="menu_bloom_config" action="action_bloom_doctor" sequence="10"/>
</odoo>
