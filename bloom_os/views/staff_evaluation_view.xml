<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bloom_staff_evaluation_tree" model="ir.ui.view">
        <field name="name">bloom.staff_evaluation.tree</field>
        <field name="model">bloom.staff_evaluation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="staff_id"/>
                <field name="evaluation_date"/>
                <field name="teamwork"/>
                <field name="cross_selling"/>
                <field name="referral"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_bloom_staff_evaluation_form" model="ir.ui.view">
        <field name="name">bloom.staff_evaluation.form</field>
        <field name="model">bloom.staff_evaluation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="staff_id"/>
                        <field name="evaluation_date"/>
                        <field name="active"/>
                    </group>
                    <group string="Sales &amp; Growth">
                        <field name="cross_selling"/>
                        <field name="upselling"/>
                        <field name="referral"/>
                        <field name="google_reviews"/>
                        <field name="renewed_clients"/>
                        <field name="marketing_involvement"/>
                    </group>
                    <group string="Service Quality">
                        <field name="welcome_greeting"/>
                        <field name="teamwork"/>
                        <field name="consent_form_compliance"/>
                        <field name="follow_up_done"/>
                        <field name="complaints"/>
                    </group>
                    <group string="Feedback">
                        <field name="client_feedback"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bloom_staff_evaluation_search" model="ir.ui.view">
        <field name="name">bloom.staff_evaluation.search</field>
        <field name="model">bloom.staff_evaluation</field>
        <field name="arch" type="xml">
            <search>
                <field name="staff_id"/>
                <group expand="0" string="Group By">
                    <filter string="Staff" name="group_staff" context="{'group_by': 'staff_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bloom_staff_evaluation" model="ir.actions.act_window">
        <field name="name">Staff Evaluations</field>
        <field name="res_model">bloom.staff_evaluation</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_bloom_staff_evaluation_search"/>
    </record>

    <menuitem id="menu_bloom_staff_evaluation" name="Staff Evaluations" parent="menu_bloom_root" action="action_bloom_staff_evaluation" sequence="35"/>
</odoo>
