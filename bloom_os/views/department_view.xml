<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bloom_department_tree" model="ir.ui.view">
        <field name="name">bloom.department.tree</field>
        <field name="model">bloom.department</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
            </tree>
        </field>
    </record>

    <record id="view_bloom_department_form" model="ir.ui.view">
        <field name="name">bloom.department.form</field>
        <field name="model">bloom.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bloom_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">bloom.department</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_bloom_department" name="Departments" parent="menu_bloom_root" action="action_bloom_department" sequence="50"/>
</odoo>
