<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bloom_department_tree" model="ir.ui.view">
        <field name="name">bloom.department.tree</field>
        <field name="model">bloom.department</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_bloom_department_form" model="ir.ui.view">
        <field name="name">bloom.department.form</field>
        <field name="model">bloom.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="Purchases">
                            <field name="purchase_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="supplier"/>
                                    <field name="order_date"/>
                                    <field name="expected_delivery_date"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bloom_department_search" model="ir.ui.view">
        <field name="name">bloom.department.search</field>
        <field name="model">bloom.department</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_bloom_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">bloom.department</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_bloom_department_search"/>
    </record>

    <menuitem id="menu_bloom_department" name="Departments" parent="menu_bloom_root" action="action_bloom_department" sequence="50"/>
</odoo>
