<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_bloom_patient" model="ir.sequence">
            <field name="name">Bloom Patient</field>
            <field name="code">bloom.patient</field>
            <field name="prefix">PAT/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
