<odoo>
    <record id="view_bloom_dashboard_form" model="ir.ui.view">
        <field name="name">bloom.dashboard.form</field>
        <field name="model">bloom.dashboard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="total_patients"/>
                        <field name="total_appointments"/>
                        <field name="total_laser_sessions"/>
                        <field name="total_slimming_sessions"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bloom_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">bloom.dashboard</field>
        <field name="view_mode">form</field>
    </record>

    <menuitem id="menu_bloom_dashboard" name="Dashboard" parent="menu_bloom_root" action="action_bloom_dashboard"/>
</odoo>
